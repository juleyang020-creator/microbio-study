.DS_Store
.superpowers/
.claude/
node_modules/
# secrets — never commit API keys
.env
.env.*
*.secret
tools/.secrets*
# 软著登记材料（申请表含个人信息，勿提交到公开仓库）
docs/软著材料/*.doc
docs/软著材料/*.docx
docs/软著材料/*.pdf
docs/软著材料/~$*
tools/.atlas-matched.json
# 审核目录下的子目录全是工具产物（示意图渲染预览、tools/*-check.mjs 的截图/JSON 证据），
# 体积大（单次可达上百 MB）且可再生，不入库；只入库 docs/审核/*.md 报告本身
docs/审核/*/
